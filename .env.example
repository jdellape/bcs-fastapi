# Path to the service account JSON key (see .vscode/tasks.json in bcs-mobile-app).
# Copy your svc-service-navigator-ro key into the repo as service-navigator-ro.json
# (gitignored) or point this to an absolute path.
GOOGLE_APPLICATION_CREDENTIALS=service-navigator-ro.json

# County document ID under counties/.../agencies (Blair in service-navigator).
FIRESTORE_COUNTY_DOC_ID=rYszDQ9QkU8hVUQhsSMz
